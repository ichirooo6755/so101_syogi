<mujoco model="so101_calligraphy">
  <!--
    Lightweight training model. Joint names, order, limits, and principal link
    lengths follow TheRobotStudio's public so101_new_calib.urdf. Meshes are
    intentionally replaced by primitives for fast Apple Silicon CPU training.
  -->
  <compiler angle="radian" autolimits="true" inertiafromgeom="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast">
    <flag contact="enable"/>
  </option>

  <default>
    <joint damping="1.1" armature="0.015" frictionloss="0.04" limited="true"/>
    <geom density="320" friction="0.9 0.02 0.002" condim="3"/>
    <site group="2"/>
  </default>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75" specular="0.1 0.1 0.1"/>
    <rgba haze="0.95 0.95 0.98 1"/>
    <global azimuth="-130" elevation="-28" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.93 0.93 0.93"
             rgb2="0.86 0.86 0.86" width="512" height="512"/>
    <material name="floor_material" texture="grid" texrepeat="4 4" reflectance="0.05"/>
    <material name="paper_material" rgba="0.98 0.97 0.91 1"/>
    <material name="printed_yellow" rgba="1.0 0.72 0.08 1"/>
    <material name="motor_dark" rgba="0.12 0.14 0.17 1"/>
    <material name="brush_dark" rgba="0.14 0.07 0.025 1"/>
    <material name="inkstone_material" rgba="0.055 0.060 0.070 1"/>
    <material name="ink_material" rgba="0.008 0.006 0.006 1"/>
  </asset>

  <worldbody>
    <light pos="0.0 -0.35 0.65" dir="0.2 0.3 -1" directional="true"/>
    <geom name="floor" type="plane" pos="0 0 -0.001" size="1 1 0.02"
          material="floor_material"/>
    <!-- solref の時定数を既定 0.02 から 0.05 へ。既定では紙が硬すぎて、穂先が
         0.164mm しか食い込んでいない払いの末端でも接触力 0.474N が残り、
         force_pressure = 1-exp(-F/1.5) が 0.27 を返していた。計画の末端目標圧
         0.02 に必要な力は 0.034N なので 14 倍の乖離があり、「筆を浮かせながら
         引く」動作が物理的に成立しなかった。制御側の対策（引き上げ上限・サーボ
         ゲイン・穂の剛性）がことごとく無効だったのはこのため。
         0.07 まで柔らかくすると line_width が 90.58->86.64 と崩れ、0.10 では
         滞留して完走しない。 -->
    <!-- 紙。2026-08-21: 上端ヒンジの可動ボディにしたところ、筆に押されて振動し
         接触ソルバが収束しない字（広・戸など）が出て、評価が CPU 95% で無限
         ループした（学習は 1 プロセスなので通るが、評価は並列なので 1 つ詰まると
         全体が終わらない）。実機忠実性より評価の完走を優先し固定に戻す。
         可動版は git 履歴（2026-08-21 の commit）にあり、接触パラメータを
         詰めてから入れ直す。solref の柔らかさ（0.05）は残す。 -->
    <geom name="paper" type="box" pos="0.200 0 0.007" size="0.105 0.1485 0.005"
          material="paper_material" friction="0.8 0.02 0.002"
          contype="0" conaffinity="2"
          solref="0.05 1"/>
    <geom name="inkstone_base" type="box" pos="0.205 -0.205 0.008"
          size="0.055 0.044 0.008" material="inkstone_material" friction="1.0 0.03 0.004"
          contype="0" conaffinity="0"/>
    <geom name="ink_pool" type="box" pos="0.205 -0.205 0.021"
          size="0.038 0.027 0.003" material="ink_material" friction="0.35 0.015 0.002"
          contype="0" conaffinity="2"
          solref="0.010 1" solimp="0.88 0.97 0.003"/>
    <geom name="inkstone_lip" type="box" pos="0.205 -0.161 0.021"
          size="0.050 0.006 0.006" material="inkstone_material" friction="1.25 0.035 0.005"
          contype="0" conaffinity="2"/>
