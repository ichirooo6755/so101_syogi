        chess_rules["局面・合法手管理<br/>FEN・特殊手・終局"]
        chess_ai["チェスAI<br/>Stockfish / UCI"]
        chess_inventory["回収先・交換駒管理<br/>捕獲駒・昇格用の駒・ポーン"]
        chess_plan["チェス操作計画<br/>移動・取り・キャスリング<br/>アンパッサン・昇格"]
    end
