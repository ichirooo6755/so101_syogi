{
  "schema_version": 1,
  "scopes": [
    "統合",
    "チェス",
    "囲碁",
    "将棋"
  ],
  "stages": [
    {
      "id": "recognition",
      "tag": "盤面認識",
      "rows": [
        {
          "label": "撮影",
          "parts": [
            {
              "scope": "統合",
              "tag": "撮影",
              "title": "対象盤を撮影",
              "description": "盤を指定して画像を取得する。",
              "module_id": "camera"
            }
          ]
        },
        {
          "label": "画像確認",
          "parts": [
            {
              "scope": "統合",
              "tag": "画像確認",
              "title": "観測できる画像を選ぶ",
              "description": "手の映り込み、遮蔽、画像の鮮度を確認する。",
              "module_id": "image_guard"
            }
          ]
        },
        {
          "label": "盤較正",
          "parts": [
            {
              "scope": "統合",
              "tag": "四隅検出と正面化",
              "title": "四隅検出と正面化",
              "description": "カメラ画像から盤の四隅を検出し、画像を補正する。",
              "module_id": "camera"
            },
            {
              "scope": "統合",
              "tag": "実測較正と盤追従",
              "title": "実測較正と盤追従",
              "description": "レンズ・ロボット座標・観測姿勢の較正を対局に接続する。",
              "module_id": "board_tracking"
            },
            {
              "scope": "チェス",
              "tag": "盤較正",
              "title": "チェス盤のマス座標",
              "description": "8×8のマス中心と駒寸法を扱う。",
              "module_id": "chess_geometry"
            },
            {
              "scope": "囲碁",
              "tag": "盤較正",
              "title": "囲碁盤の交点座標",
              "description": "9路・13路・19路の交点位置を扱う。",
              "module_id": "go_geometry"
            },
            {
              "scope": "将棋",
              "tag": "盤較正",
              "title": "将棋盤のマス座標",
              "description": "9×9のマス中心を扱う。",
              "related_module_ids": [
                "shogi_vision"
              ]
            }
          ]
        },
        {
          "label": "駒石認識",
          "parts": [
            {
              "scope": "チェス",
              "tag": "駒石認識",
              "title": "駒と空きマスの認識",
              "description": "駒種・白黒・空を判定する。",
              "module_id": "chess_vision"
            },
            {
              "scope": "囲碁",
              "tag": "駒石認識",
              "title": "交点認識",
              "description": "黒石・白石・空を判定する。",
              "module_id": "go_vision"
            },
            {
              "scope": "将棋",
              "tag": "駒石認識",
              "title": "駒の認識",
              "description": "駒種・所有者の向き・成り・空を判定する。",
              "module_id": "shogi_classifier"
            }
          ]
        }
      ]
    },
    {
      "id": "position",
      "tag": "局面確定とAI入力",
      "rows": [
        {
          "label": "人の着手推定",
          "parts": [
            {
              "scope": "統合",
              "tag": "人の着手推定",
              "title": "認識結果と直前局面の照合",
              "description": "盤ごとの認識結果を着手候補の照合に渡す。",
              "related_module_ids": [
                "shogi_vision",
                "board_tracking"
              ]
            },
            {
              "scope": "チェス",
              "tag": "人の着手推定",
              "title": "チェスの着手推定",
              "description": "移動・取り・特殊手による盤の変化を照合する。",
              "related_module_ids": [
                "chess_rules"
              ]
            },
            {
              "scope": "囲碁",
              "tag": "人の着手推定",
              "title": "囲碁の着手推定",
              "description": "配置した石と捕獲された石を照合する。",
              "related_module_ids": [
                "go_rules"
              ]
            },
            {
              "scope": "将棋",
              "tag": "人の着手推定",
              "title": "将棋の着手推定",
              "description": "9×9の画像差分と合法手から、移動・取り・打ち・成りを絞る。",
              "module_id": "shogi_vision"
            }
          ]
        },
        {
          "label": "局面確定",
          "parts": [
            {
              "scope": "統合",
              "tag": "局面確定",
              "title": "盤別の局面管理",
              "description": "盤ごとに局面・手番・履歴を保持する。",
              "related_module_ids": [
                "ui_backend"
              ]
            },
            {
              "scope": "チェス",
              "tag": "局面確定",
              "title": "チェスのルール管理",
              "description": "合法手、キャスリング権、アンパッサンの可否、終局を扱う。",
              "module_id": "chess_rules"
            },
            {
              "scope": "囲碁",
              "tag": "局面確定",
              "title": "囲碁のルール管理",
              "description": "捕獲・コウ・パス・終局を扱う。",
              "module_id": "go_rules"
            },
            {
              "scope": "将棋",
              "tag": "局面確定",
              "title": "将棋のルール管理",
              "description": "合法手、持ち駒、成りを扱う。",
              "module_id": "shogi_rules"
            }
          ]
        },
        {
          "label": "AI入力変換",
          "parts": [
            {
              "scope": "チェス",
              "tag": "AI入力変換",
              "title": "UCI入力",
              "description": "FENや指し手履歴から探索対象の局面を渡す。",
              "related_module_ids": [
                "chess_ai"
              ]
            },
            {
              "scope": "囲碁",
              "tag": "AI入力変換",
              "title": "囲碁エンジン用の入力",
              "description": "エンジンの選定後に、局面とルールを渡す形式を決める。",
              "related_module_ids": [
                "go_ai"
              ]
            },
            {
              "scope": "将棋",
              "tag": "AI入力変換",
              "title": "USI入力",
              "description": "局面と指し手履歴をやねうら王へ渡す。",
              "related_module_ids": [
                "shogi_ai"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "engine",
      "tag": "AI着手決定",
      "rows": [
        {
          "label": "探索要求",
          "parts": [
            {
              "scope": "統合",
              "tag": "探索要求",
              "title": "盤ごとに探索を要求",
              "description": "対象の盤・局面と探索条件を指定する。3面の探索は並行して進める。",
              "related_module_ids": [
                "chess_ai",
                "go_ai",
                "shogi_ai"
              ]
            }
          ]
        },
        {
          "label": "着手探索",
          "parts": [
            {
              "scope": "チェス",
              "tag": "着手探索",
              "title": "Stockfish",
              "description": "UCIで局面を受け取り、次の一手を返す。",
              "module_id": "chess_ai"
            },
            {
              "scope": "囲碁",
              "tag": "着手探索",
              "title": "囲碁エンジン",
              "description": "エンジン未選定。局面から次の一手を選ぶ。",
              "module_id": "go_ai"
            },
            {
              "scope": "将棋",
              "tag": "着手探索",
              "title": "やねうら王",
              "description": "USIで次の一手を返す。実バイナリと評価関数の試験は未実施。",
              "module_id": "shogi_ai"
            }
          ]
        },
        {
          "label": "着手応答確認",
          "parts": [
            {
              "scope": "統合",
              "tag": "着手応答確認",
              "title": "探索結果と対象局面の照合",
              "description": "盤IDと要求時の局面を照合してから応答を受理する。",
              "related_module_ids": [
                "chess_ai",
                "go_ai",
                "shogi_ai"
              ]
            },
            {
              "scope": "チェス",
              "tag": "着手応答確認",
              "title": "チェスの応答確認",
              "description": "指し手を合法手と照合する。",
              "related_module_ids": [
                "chess_rules"
              ]
            },
            {
              "scope": "囲碁",
              "tag": "着手応答確認",
              "title": "囲碁の応答確認",
              "description": "着手とパスを識別する。",
              "related_module_ids": [
                "go_rules"
              ]
            },
            {
              "scope": "将棋",
              "tag": "着手応答確認",
              "title": "将棋の応答確認",
              "description": "指し手と投了を識別する。",
              "related_module_ids": [
                "shogi_rules"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "planning",
      "tag": "動作計画",
      "rows": [
        {
          "label": "供給回収位置",
