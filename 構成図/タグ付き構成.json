            {
              "scope": "チェス",
              "tag": "供給回収位置",
              "title": "回収先と交換駒",
              "description": "捕獲駒・昇格用の交換駒・ポーンの置き場を扱う。",
              "module_id": "chess_inventory"
            },
            {
              "scope": "囲碁",
              "tag": "供給回収位置",
              "title": "碁笥とアゲハマ置き場",
              "description": "石の供給位置と捕獲石の回収先を扱う。",
              "module_id": "go_inventory"
            },
            {
              "scope": "将棋",
              "tag": "供給回収位置",
              "title": "持ち駒と駒台",
              "description": "駒種・空きスロット・実測位置を扱う。",
              "module_id": "shogi_stand"
            }
          ]
        },
        {
          "label": "操作手順",
          "parts": [
            {
              "scope": "チェス",
              "tag": "操作手順",
              "title": "チェスの操作列",
              "description": "移動・取り・キャスリング・アンパッサン・昇格を展開する。",
              "module_id": "chess_plan"
            },
            {
              "scope": "囲碁",
              "tag": "操作手順",
              "title": "囲碁の操作列",
              "description": "着手交点への配置と捕獲石の回収を展開する。",
              "module_id": "go_plan"
            },
            {
              "scope": "将棋",
              "tag": "操作手順",
              "title": "将棋の操作列",
              "description": "移動・取り・打ちと、裏返し台での成り・成駒戻しを展開する。",
              "module_id": "shogi_plan"
            }
          ]
        },
        {
          "label": "座標変換",
          "parts": [
            {
              "scope": "統合",
              "tag": "座標変換",
              "title": "アーム座標への変換",
              "description": "対象盤と供給・回収先の較正値から、操作位置をアーム座標に変換する。",
              "related_module_ids": [
                "board_tracking",
                "motion_integration"
              ]
            }
          ]
        },
        {
          "label": "経路生成",
          "parts": [
            {
              "scope": "統合",
              "tag": "経路生成",
              "title": "共通搬送と運動学",
              "description": "接近・下降・把持・持上げ・配置を共通化し、FK・IKで姿勢と経路を計算する。",
              "module_id": "motion_integration"
            }
          ]
        },
        {
          "label": "経路検証",
          "parts": [
            {
              "scope": "統合",
              "tag": "経路検証",
              "title": "MuJoCoによる経路・接触の評価",
              "description": "実測モデルで到達可否と、周囲の駒・石を含む干渉を確認する。",
              "module_id": "simulation"
            }
          ]
        }
      ]
    },
    {
      "id": "control",
      "tag": "アーム制御",
      "rows": [
        {
          "label": "操作順管理",
          "parts": [
            {
              "scope": "統合",
              "tag": "操作順管理",
              "title": "共有アームの操作順",
              "description": "3面の物理操作を順番待ちに置き、盤IDと対象局面を各操作に引き継ぐ。",
              "related_module_ids": [
                "ui_backend",
                "lerobot_control"
              ]
            }
          ]
        },
        {
          "label": "実機送信ゲート",
          "parts": [
            {
              "scope": "統合",
              "tag": "実機送信ゲート",
              "title": "送信可否を判定",
              "description": "実機への指令送信を許可する条件を確認する。",
              "module_id": "live_gate"
            }
          ]
        },
        {
          "label": "関節制御",
          "parts": [
            {
              "scope": "統合",
              "tag": "関節制御",
              "title": "LeRobot実機経路",
              "description": "関節較正と速度制約を適用し、経路・把持・解放を指令する。",
              "module_id": "lerobot_control"
            }
          ]
        },
        {
          "label": "動作監視",
          "parts": [
            {
              "scope": "統合",
              "tag": "関節と通信の監視",
              "title": "関節の追従と通信を監視",
              "description": "追従誤差と通信停止を監視する。",
              "module_id": "lerobot_control"
            },
            {
              "scope": "統合",
              "tag": "操作段階の確認",
              "title": "操作の各段階を確認",
              "description": "近接補正・把持・解放を段階ごとに確認し、異常時に停止する。",
              "module_id": "execution_monitor"
            }
          ]
        }
      ]
    },
    {
      "id": "verification",
