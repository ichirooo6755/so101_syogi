          ]
        },
        {
          "label": "結果照合",
          "parts": [
            {
              "scope": "統合",
              "tag": "結果照合",
              "title": "予定状態との照合",
              "description": "操作した盤と周辺の在庫を、着手後の予定状態と比較する。",
              "module_id": "post_action_verify"
            },
            {
              "scope": "チェス",
              "tag": "結果照合",
              "title": "チェスの確認対象",
              "description": "移動した駒、交換駒、回収先を照合する。",
              "related_module_ids": [
                "chess_plan"
              ]
            },
            {
              "scope": "囲碁",
              "tag": "結果照合",
              "title": "囲碁の確認対象",
              "description": "配置した石と捕獲石を照合する。",
              "related_module_ids": [
                "go_plan"
              ]
            },
            {
              "scope": "将棋",
              "tag": "結果照合",
              "title": "将棋の確認対象",
              "description": "移動した駒、成り、駒台を照合する。",
              "related_module_ids": [
                "shogi_plan"
              ]
            }
          ]
        },
        {
          "label": "照合結果",
          "parts": [
            {
              "scope": "統合",
              "tag": "着手確定",
              "title": "一致した場合",
              "description": "対象盤の着手を確定し、棋譜を保存して次の手番へ進む。",
              "module_id": "commit_record"
            },
            {
              "scope": "統合",
              "tag": "復旧",
              "title": "不一致の場合",
              "description": "停止して途中状態を記録し、再観測して復旧に進む。",
              "module_id": "recovery"
            }
          ]
        }
      ]
    }
  ],
  "management": [
    {
